# Normalize line endings in the repository; shell scripts stay LF even on a Windows checkout.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.nro binary
*.cpk binary
*.CPK binary

# Language statistics: count the app's own code, not the bundled libraries or the docs.
source/third_party/** linguist-vendored
library/** linguist-vendored
resources/cacert.pem linguist-vendored
docs/** linguist-documentation
